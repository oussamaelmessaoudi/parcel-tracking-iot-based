    "# 2. Feature pipelines (RF vs anomaly)\n",
    "# --------------------\n",
    "print(\"2) Feature pipelines...\")\n",
    "\n",
    "# Random Forest Features (Can include calculated history features if available, or use defaults)\n",
    "feature_cols = [\n",
    "    \"GPS Latitude\", \"GPS Longitude\", \"Temperature\", \"Humidity\",\n",
    "    \"Speed\", \"dist_approx\", \"speed_calc\", \"time_diff_secs\",\n",
    "    \"temp_alert\", \"Delay_Time_Num\", \"Cost_Num\", \"hour_of_day\", \"day_of_week\"\n",
    "]\n",
    "cat_cols = [\"Delivery Status\", \"Stage\", \"Route ID\", \"Entity\", \"Risk Factor\", \"Disruption Type\"]\n",
    "\n",
    "# Index + OHE for categorical variables (used in RF)\n",
    "indexers = [StringIndexer(inputCol=c, outputCol=c + \"_idx\", handleInvalid=\"keep\") for c in cat_cols]\n",
    "encoders = [OneHotEncoder(inputCol=c + \"_idx\", outputCol=c + \"_vec\") for c in cat_cols]\n",
    "\n",
    "# RF vector\n",
    "rf_input_cols = feature_cols + [c + \"_vec\" for c in cat_cols]\n",
    "assembler_rf = VectorAssembler(inputCols=rf_input_cols, outputCol=\"features_raw\", handleInvalid=\"keep\")\n",
    "scaler_rf = StandardScaler(inputCol=\"features_raw\", outputCol=\"features_rf\", withMean=True, withStd=True)\n",
    "\n",
    "# --- CRITICAL FIX FOR ANOMALY MODEL ---\n",
