    "# --------------------\n",
    "# 5. KMeans: tune k by silhouette, anomaly scoring\n",
    "# --------------------\n",
    "print(\"5) KMeans - tuning k by silhouette and anomaly scoring\")\n",
    "\n",
    "# 1. Create & Fit the Second Scaler (StandardScaler on top of the first one)\n",
    "# This is part of your pipeline structure.\n",
    "scaler_for_k = StandardScaler(inputCol=\"features_anom\", outputCol=\"scaled_features_k\", withMean=False, withStd=True)\n",
    "scaler_for_k_model = scaler_for_k.fit(train_df)\n",
    "\n",
    "# --- SAVE THIS SCALER (Required for Consumer) ---\n",
    "try:\n",
    "    scaler_for_k_model.write().overwrite().save(os.path.join(MODELS_DIR, \"scaler_k\"))\n",
    "    print(\"SUCCESS: scaler_k model saved.\")\n",
    "except Exception as e:\n",
    "    print(f\"Warning: scaler_k save failed: {e}\")\n",
    "# -----------------------------------------------\n",
    "\n",
    "# 2. Transform Data\n",
    "train_k = scaler_for_k_model.transform(train_df)\n",
    "test_k = scaler_for_k_model.transform(test_df)\n",
    "\n",
    "# 3. Hyperparameter Tuning (Find Best K)\n",
    "best_k = 2\n",
    "best_sil = -1.0\n",
    "print(\"   Finding best k...\")\n",
    "for k in range(2, 11):\n",
    "    km = KMeans(featuresCol=\"scaled_features_k\", k=k, seed=42, maxIter=50)\n",
    "    km_model_try = km.fit(train_k)\n",
    "    preds_try = km_model_try.transform(test_k)\n",
    "    sil = ClusteringEvaluator(featuresCol=\"scaled_features_k\", predictionCol=\"prediction\", metricName=\"silhouette\").evaluate(preds_try)\n",
    "    print(f\"   k={k} silhouette={sil:.4f}\")\n",
    "    if sil > best_sil:\n",
    "        best_sil = sil\n",
    "        best_k = k\n",
    "\n",
    "print(f\"Selected k={best_k} with silhouette={best_sil:.4f}\")\n",
    "\n",
    "# 4. Train Final Model\n",
    "kmeans = KMeans(featuresCol=\"scaled_features_k\", k=best_k, seed=42, maxIter=100)\n",
    "kmeans_model = kmeans.fit(train_k)\n",
    "kmeans_preds = kmeans_model.transform(test_k)\n",
    "\n",
    "# 5. Anomaly Scoring Logic\n",
    "# Broadcast centers to use inside UDF (avoid serialization issues)\n",
    "centers = [c.tolist() if hasattr(c, \"tolist\") else list(c) for c in kmeans_model.clusterCenters()]\n",
    "b_centers = spark.sparkContext.broadcast(centers)\n",
    "\n",
    "def kdist_sq(vec, cluster_id):\n",
    "    if vec is None or cluster_id is None:\n",
    "        return 0.0\n",
    "    arr = np.array(vec.toArray())\n",
    "    center = np.array(b_centers.value[int(cluster_id)])\n",
    "    return float(np.sum((arr - center) ** 2))\n",
    "\n",
    "kdist_udf = udf(kdist_sq, DoubleType())\n",
    "\n",
    "kmeans_preds = kmeans_preds.withColumn(\"KMeans_Anomaly_Score\", kdist_udf(col(\"scaled_features_k\"), col(\"prediction\")))\n",
    "\n",
    "# 6. Calculate Statistics & Thresholds\n",
    "k_thresh = kmeans_preds.approxQuantile(\"KMeans_Anomaly_Score\", [0.95], 0.001)[0]\n",
    "k_anoms = kmeans_preds.filter(col(\"KMeans_Anomaly_Score\") > k_thresh).count()\n",
    "silhouette_val = ClusteringEvaluator(featuresCol=\"scaled_features_k\", predictionCol=\"prediction\", metricName=\"silhouette\").evaluate(kmeans_preds)\n",
    "\n",
    "print(f\"KMeans silhouette={silhouette_val:.4f}, threshold(95%)={k_thresh:.4f}, anomalies={k_anoms}\")\n",
    "\n",
    "# 7. Save Final KMeans Model\n",
    "try:\n",
    "    kmeans_model.write().overwrite().save(os.path.join(MODELS_DIR, \"kmeans_pipeline\"))\n",
    "    print(\"SUCCESS: KMeans model saved.\")\n",
    "except Exception as e:\n",
    "    print(\"Warning: KMeans save failed:\", e)"
   ]
